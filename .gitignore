# Telerik's JustMock configuration file
*.jmconfig

# BizTalk build output
*.btp.cs
*.btm.cs
*.odx.cs
*.xsd.cs

*.ini
!skin.ini
*.dat
*.bak
/TrafficMonitor/skins/test*
[Dd]ebug (without temperature)/
[Rr]elease (without temperature)/
[Dd]ebug (lite)/
[Rr]elease (lite)/
/TrafficMonitor/compile_time.txt
!/TrafficMonitor/language/*.ini
*.diagsession
enc_temp*

