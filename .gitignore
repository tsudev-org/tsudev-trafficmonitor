CMakeCache.txt
cmake-build-*/
packages/*/bin/
packages/*/obj/

# --- 6. Log & file tạm ---
*.log
logs/*.log
logs/*.tmp
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
tmp/
temp/
scratch/
.scratch/
*.swp
