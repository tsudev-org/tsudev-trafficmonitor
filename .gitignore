# ============================================================
# .GITIGNORE CHUẨN TOÀN HỆ SINH THÁI tsudev - base v2.0.0
# Nguồn: tsudev-standards/templates/gitignore/base.gitignore
# Đây là chuẩn TỐI THIỂU. Được phép THÊM, KHÔNG được phép XÓA BỚT.
# Quy tắc: hễ tạo ra file/thư mục chứa secret, cache, build output, dữ liệu
# cá nhân -> BỔ SUNG vào đây TRƯỚC KHI commit. Chi tiết: docs/GITIGNORE_POLICY.md
# Checklist bảo mật trước commit/PR/merge/deploy/push: AGENTS.md mục 3.
# ============================================================

# --- 1. Biến môi trường & cấu hình nhạy cảm (TUYỆT ĐỐI không commit) ---
.env
.env.*
!.env.example
!.env.sample
!.env.*.example
!.env.*.sample
.envrc
.direnv/
config.local.*
appsettings.*.local.json
local.settings.json
secrets.json
secrets.yml
secrets.yaml
*secret*
*credential*
*password*
!**/*secret*.example
!**/*credential*.example

# --- 2. Khóa, chứng chỉ, token (lộ một lần là lộ vĩnh viễn) ---
*.pem
*.key
!**/*.public.key
*.pfx
*.p12
*.jks
*.keystore
*.crt
*.cer
*.der
*.asc
*.gpg
*.kdbx
*.token
*.pat
id_rsa*
id_ecdsa*
id_ed25519*
*.ppk
*.ovpn
.ssh/
.gnupg/
service-account*.json
gha-creds-*.json
client_secret*.json
firebase-adminsdk*.json
google-services.json
GoogleService-Info.plist
.npmrc
.yarnrc.yml
.pypirc
.netrc
_netrc
.dockercfg
.docker/config.json
kubeconfig
*.kubeconfig
.aws/
.azure/
gcloud-key*.json

# --- 3. Hạ tầng dưới dạng mã (chứa state và secret rò rỉ) ---
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.terraformrc
terraform.rc
.pulumi/
Pulumi.*.yaml
!Pulumi.yaml
ansible/inventory/production*
*.retry

# --- 4. Bản build & bản phát hành ---
dist/
build/
release/
out/
target/
bin/
obj/
Debug/
Release/
x64/
x86/
*.exe
*.msi
*.dmg
*.pkg
*.deb
*.rpm
*.AppImage
*.apk
*.aab
*.ipa
*.app
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
!lib/**/*.dll
*.pyc
*.pyo
*.class
*.jar
!gradle/wrapper/gradle-wrapper.jar
*.war

