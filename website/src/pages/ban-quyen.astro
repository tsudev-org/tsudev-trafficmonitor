---
import TaiLieu from '../components/TaiLieu.astro';
import { docTep, renderMd } from '../lib/noi-dung';
const notice = renderMd('NOTICE.md');
const vi = renderMd('LICENSE_VI.md');
const goc = docTep('LICENSE');
---
<TaiLieu tieuDe="Bản quyền" moTa="Bản quyền và giấy phép TrafficMonitor-VN: thông báo bản quyền, giấy phép Anti 996 nguyên văn kèm bản dịch, thư viện bên thứ ba." duongDan="/ban-quyen/" html={notice.html} nguon="NOTICE.md">
  <h2 id="ban-dich-giay-phep">Bản dịch giấy phép</h2>
  <Fragment set:html={vi.html.replace(/<h1[^>]*>.*?<\/h1>/, '')} />
  <h2 id="giay-phep-nguyen-van">Giấy phép nguyên văn (LICENSE)</h2>
  <pre class="giay-phep">{goc}</pre>
</TaiLieu>
