---
import Trang from '../layouts/Trang.astro';
import { banMoiNhat, REPO_URL } from '../lib/noi-dung';

const ban = await banMoiNhat();
const x64 = ban.goi.find((g) => g.kienTruc === 'x64');
const tinhNang = [
  { t: 'Tốc độ mạng theo thời gian thực', d: 'Tốc độ tải lên, tải xuống hiện trên cửa sổ nổi nhỏ gọn hoặc ngay trên thanh tác vụ Windows.' },
  { t: 'CPU, RAM, GPU, ổ cứng', d: 'Theo dõi mức sử dụng tài nguyên máy cùng lúc với tốc độ mạng; tùy chọn hiện biểu đồ trên thanh tác vụ.' },
  { t: 'Giao diện tiếng Việt đầy đủ', d: 'Mặc định tiếng Việt ngay lần chạy đầu, dịch đủ 100% chuỗi giao diện, tài liệu hướng dẫn bằng tiếng Việt.' },
  { t: 'Thu gọn vào mép màn hình', d: 'Kéo cửa sổ nổi sát mép là nó trượt khuất, chỉ còn mũi tên nhỏ; bấm mũi tên là trượt trở lại, chuyển động mượt.' },
  { t: 'Thống kê lưu lượng', d: 'Lưu lượng đã dùng theo ngày, tháng, năm; cảnh báo khi dùng hết hạn mức dữ liệu trong ngày.' },
  { t: 'Đổi giao diện (skin), plugin', d: '13 mẫu giao diện có sẵn, gồm 5 mẫu tsudev (có mẫu mang logo sản phẩm); tự làm mẫu riêng; mở rộng thông số bằng plugin.' },
  { t: 'Chạy ngoại tuyến, không tài khoản', d: 'Không thu thập dữ liệu. Mạng chỉ dùng để kiểm tra bản cập nhật và tra IP công cộng khi bạn bấm.' },
];
const baoMat = [
  { t: 'Bản cập nhật có chữ ký', d: 'Thông tin phiên bản được ký ECDSA và xác minh trong ứng dụng; kèm SHA-256 của từng gói.' },
  { t: 'Chứng thực nguồn gốc build', d: 'Mỗi gói được GitHub Actions build từ mã nguồn công khai và chứng thực, kiểm tra được bằng gh attestation verify.' },
  { t: 'Chỉ HTTPS, máy chủ cho phép', d: 'Mọi kết nối chỉ qua HTTPS tới danh sách máy chủ cố định, có giới hạn thời gian và kích thước.' },
  { t: 'Không tài khoản, không gửi dữ liệu', d: 'Chưa đăng nhập tài khoản tsudev thì ứng dụng không gửi dữ liệu nào của bạn; Chế độ ngoại tuyến hoàn toàn chặn mọi kết nối tự động.' },
  { t: 'Gia cố tệp chương trình', d: 'Bật Control Flow Guard, ASLR, DEP, CET; chống nạp DLL giả mạo khi khởi động và khi nạp plugin.' },
];
---
<Trang moTa="Tsu Tramon: phần mềm theo dõi tốc độ mạng, CPU, RAM trên Windows, giao diện tiếng Việt, gia cố bảo mật, miễn phí và mã nguồn mở." duongDan="/">
  <section class="mo-dau">
    <div class="khung mo-dau__luoi">
      <div class="mo-dau__chu">
        <span class="nhan">Phiên bản {ban.phienBan} · {ban.ngay}</span>
        <h1>Theo dõi tốc độ mạng và tài nguyên máy, <span class="chu-nhan">bằng tiếng Việt</span></h1>
        <p class="mo-dau__phu">Tsu Tramon hiện tốc độ mạng, mức dùng CPU, RAM ngay trên thanh tác vụ Windows. Nhẹ, miễn phí, mã nguồn mở và được gia cố bảo mật.</p>
        <div class="mo-dau__nut">
          {x64 && <a class="nut nut--chinh" href={x64.url}>Tải bản 64-bit (x64)</a>}
          <a class="nut nut--phu" href="/tai-ve/">Bản khác và kiểm tra tệp</a>
        </div>
        <p class="mo-dau__ghi-chu">Windows 10 và 11 · bản Lite, không cần quyền Quản trị viên · giải nén là chạy</p>
      </div>
      <div class="trinh-dien">
        {/* Hoạ tiết duong-bieu-do (DESIGN_SYSTEM 1.2): đường lưu lượng TĨNH, chỉ dùng --accent/--glow, phủ <= 15% hero */}
        <svg class="trinh-dien__hoa-tiet" viewBox="0 0 600 200" preserveAspectRatio="none" aria-hidden="true" focusable="false">
          <path class="vung" d="M0 170 L40 150 L80 158 L120 120 L160 132 L200 96 L240 110 L280 70 L320 88 L360 54 L400 76 L440 40 L480 62 L520 30 L560 48 L600 22 L600 200 L0 200 Z" />
          <path class="duong" d="M0 170 L40 150 L80 158 L120 120 L160 132 L200 96 L240 110 L280 70 L320 88 L360 54 L400 76 L440 40 L480 62 L520 30 L560 48 L600 22" />
          <path class="duong duong--phu" d="M0 186 L40 178 L80 182 L120 166 L160 172 L200 150 L240 160 L280 138 L320 148 L360 124 L400 136 L440 112 L480 126 L520 104 L560 116 L600 96" />
        </svg>
        <figure class="trinh-dien__chinh">
          <img src="/anh/vi/options.png" alt="Hộp thoại Cài đặt tiếng Việt của Tsu Tramon" width="522" height="426" fetchpriority="high">
        </figure>
        <figure class="trinh-dien__noi">
          <img src="/anh/vi/main.png" alt="Cửa sổ nổi với skin mặc định: tốc độ tải lên, tải xuống, CPU và RAM" width="232" height="55">
          <figcaption>Cửa sổ nổi</figcaption>
        </figure>
        <figure class="trinh-dien__khay">
          <img src="/anh/vi/taskbar.png" alt="Tốc độ mạng hiện trên thanh tác vụ Windows" width="91" height="44">
          <figcaption>Thanh tác vụ</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="muc" aria-labelledby="tinh-nang">
    <div class="khung">
      <h2 id="tinh-nang">Tính năng</h2>
      <p class="muc__dan">Giữ nguyên mọi tính năng của TrafficMonitor gốc, thêm giao diện tiếng Việt và các lớp bảo vệ cho người dùng.</p>
      <ul class="bento">
        {tinhNang.map((x, i) => (
          <li class={`the${i === 0 ? ' the--lon' : ''}${i === tinhNang.length - 1 ? ' the--rong' : ''}`}>
            {i === 0 && (
              <svg class="bento__bieu-do" viewBox="0 0 300 80" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                <path class="duong" d="M0 62 L25 55 L50 60 L75 40 L100 46 L125 30 L150 38 L175 20 L200 28 L225 14 L250 24 L275 8 L300 16" />
                <path class="duong duong--phu" d="M0 74 L25 70 L50 72 L75 64 L100 67 L125 58 L150 62 L175 52 L200 56 L225 46 L250 52 L275 42 L300 46" />
              </svg>
            )}
            <h3>{x.t}</h3><p>{x.d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="muc" aria-labelledby="anh-chup">
    <div class="khung">
      <h2 id="anh-chup">Ảnh chụp</h2>
      <p class="muc__dan">Giao diện tiếng Việt trên Windows 11.</p>
      <div class="anh-luoi">
        <figure>
          <img src="/anh/skins/tsudev_DoThi_Toi.png" alt="Skin tsudev đồ thị mạng, nền tối" width="348" height="120" loading="lazy">
          <figcaption>Skin đồ thị mạng (13 skin có sẵn)</figcaption>
        </figure>
        <figure>
          <img src="/anh/vi/network_info.png" alt="Hộp thoại Chi tiết mạng" width="436" height="300" loading="lazy">
          <figcaption>Chi tiết mạng</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="muc" aria-labelledby="bao-mat">
    <div class="khung">
      <h2 id="bao-mat">An toàn từ khâu build tới khâu cập nhật</h2>
      <p class="muc__dan">Chi tiết và cách tự kiểm tra ở trang <a href="/bao-mat/">Bảo mật</a> và <a href="/quyen-rieng-tu/">Quyền riêng tư</a>.</p>
      <ul class="the-luoi">
        {baoMat.map((x) => <li class="the"><h3>{x.t}</h3><p>{x.d}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="muc" aria-labelledby="nguon-goc">
    <div class="khung">
      <h2 id="nguon-goc">Mã nguồn và giấy phép</h2>
      <p class="muc__dan">Tsu Tramon là bản phái sinh của TrafficMonitor, phát hành theo giấy phép Anti 996; giấy phép và thông báo bản quyền bắt buộc có tại trang Bản quyền. Mã nguồn công khai tại <a href={REPO_URL} target="_blank" rel="noopener noreferrer">GitHub</a>. Hạng sản phẩm C theo quy ước tsudev: chạy ngoại tuyến, không tài khoản.</p>
      <div class="mo-dau__nut">
        <a class="nut nut--phu" href="/huong-dan/">Đọc hướng dẫn</a>
        <a class="nut nut--phu" href="/ban-quyen/">Bản quyền</a>
      </div>
    </div>
  </section>
</Trang>
