{
  "schema": 1,
  "name": "tsutramon",
  "winget": "tsudev.TrafficMonitor",
  "homepage": "https://tramon.tsudev.com",
  "license": "LicenseRef-Anti-996",
  "description": {
    "vi": "Theo dõi tốc độ mạng, CPU, RAM trên thanh tác vụ Windows - bản Việt hóa, gia cố bảo mật của TrafficMonitor (dự án gốc)",
    "en": "Network speed, CPU and RAM monitor in the Windows taskbar - Vietnamese, security-hardened edition of the original TrafficMonitor"
  },
  "release": {
    "repo": "tsudev-org/tsutramon",
    "tagRegex": "^[vV](?<version>\\d+\\.\\d+\\.\\d+)(-vn)?$",
    "sums": "SHA256SUMS.txt"
  },
  "assets": {
    "windows-x64": {
      "file": "tsutramon_{version}_windows-x64.zip",
      "kind": "portable",
      "bin": "TsuTramon/TsuTramon.exe"
    },
    "windows-x86": {
      "file": "tsutramon_{version}_windows-x86.zip",
      "kind": "portable",
      "bin": "TsuTramon/TsuTramon.exe"
    },
    "windows-arm64": {
      "file": "tsutramon_{version}_windows-arm64ec.zip",
      "kind": "portable",
      "bin": "TsuTramon/TsuTramon.exe"
    }
  },
  "channels": [
    "scoop"
  ],
  "planned": [
    "winget"
  ]
}
